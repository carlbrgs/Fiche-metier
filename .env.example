# Variables lues par docker-compose.yml.
# Copier en `.env` à la racine pour surcharger les valeurs par défaut.
# À ne pas confondre avec back/.env, qui configure le back lancé en `npm run dev`.

DB_NAME=fiche_metiers
DB_USER=fiche
DB_PASSWORD=fichepwd
DB_ROOT_PASSWORD=rootpwd
DB_PORT=3306

BACK_PORT=4000
FRONT_PORT=8080
CORS_ORIGIN=http://localhost:8080

# Connexion à la plateforme — un seul compte. Valeurs de développement par défaut :
# à changer avant tout déploiement (voir README « Reste à faire »).
AUTH_USERNAME=admin
AUTH_PASSWORD=changez-moi
AUTH_SESSION_SECRET=changez-moi-aussi-une-longue-chaine-aleatoire
