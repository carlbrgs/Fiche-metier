{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Sans `baseUrl`, retiré par TypeScript 7 : les chemins sont relatifs au tsconfig.
    // Doit rester aligné sur `resolve.alias` dans vite.config.ts.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
