# Serveur
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Base de données MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fiche_metiers
DB_USER=fiche
DB_PASSWORD=fichepwd
DB_LOGGING=false

# Chemins des classeurs sources (import)
XLSX_FORMACODES=../Base formacodes_DC structurants.xlsx
XLSX_COMPETENCES=../251230_base competences_V3.3.xlsm

# Connexion à la plateforme — un seul compte, pas de table utilisateur.
# AUTH_SESSION_SECRET : chaîne aléatoire longue, sert uniquement à signer le cookie de
# session (indépendante du mot de passe). En changer déconnecte tout le monde.
AUTH_USERNAME=admin
AUTH_PASSWORD=changez-moi
AUTH_SESSION_SECRET=changez-moi-aussi-une-longue-chaine-aleatoire
